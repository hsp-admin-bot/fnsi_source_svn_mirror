  "#":"------- プロットの共通設定 -------",
  "plotOptions": {
    "series": {
      "type": "spline",
      "marker": {
        "lineWidth": 1,
        "lineColor": "#000000"
      },
      "label": {
        "enabled": false
      },
      "animation": false
    }
  },

  "#":"------- シリーズの設定 -------",
  "series": [
    {
      "id":"1",
      "type": "line",
      "lineWidth": #bpMax.lineWidth#,
      "lineColor": "#bpMax.lineColor#",
      "color": "#FFFFFF",
      "dashStyle": "#bpMax.lineType#",
