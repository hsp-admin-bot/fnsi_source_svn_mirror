{
  "chart": {
    "marginLeft": #chart.marginLeft#,
    "marginRight": 10,
    "marginTop": 40,
    "width": #chart.width#,
    "height": #chart.height#,
    "style": {
      "fontFamily": "#chart.fontFamily#"
    },
    "animation": false
  },
  "exporting": {
    "enabled": false
  },
  "time": { "useUTC": false },
  "credits": { "enabled": false },
  "title": { "text": "" },
  "lang": {
    "noData": ""
  },

  "#":"------- 凡例の設定 -------",
  "legend": {
    "enabled": false,
    "labelFormat": " ",
    "rtl": false,
    "verticalAlign": "top",
    "align": "left",
    "y": 20,
    "x": #legend.x#,
    "symbolPadding": 5,
    "layout":"#legend.layout#",
    "itemDistance": #legend.itemDistance#,
    "reversed": true
  },



  "#":"------- x軸の設定 -------",
  "xAxis": {
    "type": "datetime",
    "labels": {
      "enabled": #xAxis.label.enabled#,
      "style":{
        "color":"#000000"
      },
      "formatter": function(){Highcharts.setOptions({'time': {'useUTC': false}}); return Highcharts.dateFormat("%H:%M", this.value + #xAxis.label.offsetValue#)}
    },
    "tickInterval": 1800000,
    "showEmpty": true,
    "opposite": true,
    "gridLineWidth": 1,
    "gridLineColor": "#000000",
    "lineWidth": 0,
    "tickColor": "#000000",
    "minorGridLineDashStyle": "Dash",
    "minorGridLineWidth": 1,
    "minorTickInterval": 900000,
    "minorGridLineColor": "#a5a5a5",
    "min": #xAxis.min#,
    "max": #xAxis.max#,
    "showFirstLabel":false,
    "showLastLabel":false
  },

  "#":"------- y軸の設定 -------",
  "yAxis": [
    {
      "showEmpty": true,
      "min": 0,
      "max": 250,
      "tickInterval": 50,
      "tickWidth": 1,
      "tickAmount": 6,
      "gridLineWidth": 1,
      "gridLineColor": "#000000",
      "minorGridLineDashStyle": "Dash",
      "minorGridLineColor": "#a5a5a5",
      "minorTicks": true,
      "tickColor": "#000000",
      "showFirstLabel":false,
      "showLastLabel": false,
      "title": {
        "enabled": false
      },
      "labels": {
        "enabled": false
      }
    },
    {
      "#":"最高血圧",
      "showEmpty": true,
      "min": #bp.min#,
      "max": #bp.max#,
      "alignTicks": false,
        "tickPositioner": function () {
        return [#bp.tickPositioner#]
        },
      "gridLineWidth": 1,
      "gridLineColor": "#000000",
      "showFirstLabel":true,
      "showLastLabel": false,
      "title": {
        "align": "high",
        "rotation":0,
        "text": "#bpMin.itemName#",
        "y": -10,
        "x": 60,
        "margin": 0
      },
      "labels": {
        "reserveSpace": false,
        "align": "center",
        "padding": 0,
        "enabled": true,
        "format": "#bp.labelsFormat#",
        "style":{
          "color":"#000000"
        },
        "x": -10
      }
    },
    {
      "#":"----- 選択項目1 -----",
      "showEmpty": true,
      "min": #item1.min#,
      "max": #item1.max#,
      "tickPositioner": function () {
        return [#item1.tickPositioner#]
      },
      "showFirstLabel":true,
      "showLastLabel": false,
      "title": {
        "align": "high",
        "text" : "#item1.itemName#",
        "rotation": 0,
        "y": -10,
        "x": 40,
        "enabled": #item1.enabled#,
        "margin": 0
      },
      "labels": {
        "reserveSpace": false,
        "align": "center",
        "padding": 0,
        "enabled": #item1.enabled#,
        "format": "#item1.labelsFormat#",
        "style":{
          "color":"#000000"
        },
        "x": -10
