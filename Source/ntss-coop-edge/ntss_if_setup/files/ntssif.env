NTSS_CHECK_CONNECT_ALIVE_INTERVAL=300
NTSS_SOAP_WSDL_FILE=/home/ntss/if_edge/conf/soapNecSi.wsdl
NTSS_SOAP_RESPONSE_XML_FILE=/home/ntss/if_edge/conf/soapNecSiResponse.xml
