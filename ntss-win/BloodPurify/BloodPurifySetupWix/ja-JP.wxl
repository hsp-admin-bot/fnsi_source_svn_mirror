  <String Id="ResumeDlgTitle" Value="{\WixUI_Font_Bigger}FNWSi Blood Purify セットアップ ウィザードの再開" />
  <String Id="InstallDirDlgFolderLabel" Value="FNWSi Blood Purify のインストール先:" />
