<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>FNWSiConvertToolSetup</OutputName>
    <Platforms>x86</Platforms>
    <Platform Condition="'$(Platform)' == ''">x86</Platform>
    <Cultures>ja-JP</Cultures>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <!--
      ★ バージョンアップ時はここだけ変更する ★
      ProductCode は UpgradeCodeGuid + ProductVersion から自動生成される（UUID v5）
      UpgradeCodeGuid は絶対に変えない
    -->
    <ProductVersion>2.0.33</ProductVersion>
    <UpgradeCodeGuid>D3D92813-23E0-4C96-B845-E9430C3E8F30</UpgradeCodeGuid>
    <DefineConstants>
      SrcBin=$(MSBuildProjectDirectory)\..\NKSConverter\bin\$(Configuration)\;
      EnvBuildRoot=$(MSBuildProjectDirectory)\..\..\環境構築\;
      ProductVersion=$(ProductVersion)
    </DefineConstants>
    <HarvestDirectoryGenerateGuidsNow>true</HarvestDirectoryGenerateGuidsNow>
    <HarvestDirectoryAutogenerateGuids>false</HarvestDirectoryAutogenerateGuids>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext"   Version="4.0.6" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.6" />
    <PackageReference Include="WixToolset.Heat"        Version="4.0.6" />
  </ItemGroup>

  <!-- SQL フォルダを自動ハーベスト -->
  <ItemGroup>
    <HarvestDirectory Include="$(MSBuildProjectDirectory)\..\ConvertCommon\SQL">
      <ComponentGroupName>CG_SqlFiles</ComponentGroupName>
      <DirectoryRefId>SQLFOLDER</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
    <BindPath Include="$(MSBuildProjectDirectory)\..\ConvertCommon\SQL" />

    <!--
      環境構築配下をサブフォルダ単位でハーベスト（oracle_Client のみ exe 同階層へ分離）
      - 01_FNW / 02_次世代 / coop → Tools\環境構築\...（アプリの ConfigSetting パスと一致）
      - coop を追加で Tools\連携設定\ にも同内容配置（旧フォルダ名互換。環境構築\coop は維持）
      - oracle_Client → インストールルート（DeleteOracleClient 等と一致）
    -->
    <HarvestDirectory Include="$(MSBuildProjectDirectory)\..\..\環境構築\01_FNW(移行元)環境用スクリプト">
      <ComponentGroupName>CG_ToolFilesFnw01</ComponentGroupName>
      <DirectoryRefId>DIR_01_FNW_SETUP</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
    <BindPath Include="$(MSBuildProjectDirectory)\..\..\環境構築\01_FNW(移行元)環境用スクリプト" />
    <HarvestDirectory Include="$(MSBuildProjectDirectory)\..\..\環境構築\02_次世代(移行先)環境用スクリプト">
      <ComponentGroupName>CG_ToolFilesNext02</ComponentGroupName>
      <DirectoryRefId>DIR_02_NEXT_SETUP</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
    <BindPath Include="$(MSBuildProjectDirectory)\..\..\環境構築\02_次世代(移行先)環境用スクリプト" />
    <HarvestDirectory Include="$(MSBuildProjectDirectory)\..\..\環境構築\coop">
      <ComponentGroupName>CG_ToolFilesCoop</ComponentGroupName>
      <DirectoryRefId>DIR_COOP_SETUP</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
    <BindPath Include="$(MSBuildProjectDirectory)\..\..\環境構築\coop" />
    <!-- 同一ソース coop を Tools\連携設定 にも配置（coop 本体は上記 CG_ToolFilesCoop で維持） -->
    <HarvestDirectory Include="$(MSBuildProjectDirectory)\..\..\環境構築\coop">
      <ComponentGroupName>CG_ToolFilesCoopRenkei</ComponentGroupName>
      <DirectoryRefId>DIR_RENKEI_SETTINGS</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
    <HarvestDirectory Include="$(MSBuildProjectDirectory)\..\..\環境構築\oracle_Client">
      <ComponentGroupName>CG_OracleClient</ComponentGroupName>
      <DirectoryRefId>DIR_ORACLE_CLIENT</DirectoryRefId>
      <SuppressRootDirectory>true</SuppressRootDirectory>
    </HarvestDirectory>
    <BindPath Include="$(MSBuildProjectDirectory)\..\..\環境構築\oracle_Client" />
  </ItemGroup>

  <!--
    ビルド前に ProductCode を自動生成（UUID v5: UpgradeCode + Version のハッシュ）
    外部スクリプト不要: インライン C# タスクで完結
  -->
  <UsingTask TaskName="GenerateUuidV5ProductCode"
             TaskFactory="CodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <UpgradeCode    ParameterType="System.String" Required="true" />
      <ProductVersion ParameterType="System.String" Required="true" />
      <OutputFile     ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var nsGuid  = System.Guid.Parse(UpgradeCode);
        var nsBytes = nsGuid.ToByteArray();
        System.Array.Reverse(nsBytes, 0, 4);
        System.Array.Reverse(nsBytes, 4, 2);
        System.Array.Reverse(nsBytes, 6, 2);

        var verBytes = System.Text.Encoding.UTF8.GetBytes(ProductVersion);
        var input    = new byte[nsBytes.Length + verBytes.Length];
        System.Array.Copy(nsBytes,  0, input, 0,              nsBytes.Length);
        System.Array.Copy(verBytes, 0, input, nsBytes.Length,  verBytes.Length);

        var sha1 = System.Security.Cryptography.SHA1.Create();
        var hash = sha1.ComputeHash(input);

        var h = new byte[16];
        System.Array.Copy(hash, h, 16);
        h[6] = (byte)((h[6] & 0x0F) | 0x50);
        h[8] = (byte)((h[8] & 0x3F) | 0x80);

        System.Array.Reverse(h, 0, 4);
        System.Array.Reverse(h, 4, 2);
        System.Array.Reverse(h, 6, 2);

        var productCode = new System.Guid(h).ToString("B").ToUpper();
        Log.LogMessage(MessageImportance.High, "ProductCode (v" + ProductVersion + "): " + productCode);

        var lines = new string[] {
            "<?xml version=\"1.0\" encoding=\"utf-8\"?>",
            "<Include>",
            "  <?define ProductCode = \"" + productCode + "\" ?>",
            "</Include>"
        };
        System.IO.File.WriteAllLines(OutputFile, lines, System.Text.Encoding.UTF8);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateProductCode" BeforeTargets="CoreCompile;Build">
    <GenerateUuidV5ProductCode
      UpgradeCode="$(UpgradeCodeGuid)"
      ProductVersion="$(ProductVersion)"
      OutputFile="$(MSBuildProjectDirectory)\GeneratedProductCode.wxi" />
  </Target>

  <!--
    ビルド後に MaintenanceTypeDlg の ChangeButton を非表示にする
  -->
  <UsingTask TaskName="HideMsiChangeButton"
             TaskFactory="CodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <MsiPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var type      = System.Type.GetTypeFromProgID("WindowsInstaller.Installer");
        var installer = System.Activator.CreateInstance(type);
        var db = type.InvokeMember("OpenDatabase", System.Reflection.BindingFlags.InvokeMethod, null, installer,
                     new object[] { MsiPath, 1 });
        var dbType = db.GetType();
        var sqls = new string[][] {
            new string[] {
                "INSERT INTO ControlCondition (Dialog_, Control_, Action, Condition) VALUES ('MaintenanceTypeDlg', 'ChangeButton',       'Hide', '1')",
                "UPDATE ControlCondition SET Condition = '1' WHERE Dialog_ = 'MaintenanceTypeDlg' AND Control_ = 'ChangeButton'       AND Action = 'Hide'"
            },
            new string[] {
                "INSERT INTO ControlCondition (Dialog_, Control_, Action, Condition) VALUES ('MaintenanceTypeDlg', 'ChangeDisabledText', 'Hide', '1')",
                "UPDATE ControlCondition SET Condition = '1' WHERE Dialog_ = 'MaintenanceTypeDlg' AND Control_ = 'ChangeDisabledText' AND Action = 'Hide'"
            }
        };
        foreach (var sqlPair in sqls) {
            var view = dbType.InvokeMember("OpenView", System.Reflection.BindingFlags.InvokeMethod, null, db,
                           new object[] { sqlPair[0] });
            var viewType = view.GetType();
            bool ok = false;
            try {
                viewType.InvokeMember("Execute", System.Reflection.BindingFlags.InvokeMethod, null, view, null);
                ok = true;
            } catch (System.Runtime.InteropServices.COMException) { }
            viewType.InvokeMember("Close", System.Reflection.BindingFlags.InvokeMethod, null, view, null);
            if (!ok) {
                var upd = dbType.InvokeMember("OpenView", System.Reflection.BindingFlags.InvokeMethod, null, db,
                              new object[] { sqlPair[1] });
                var updType = upd.GetType();
                updType.InvokeMember("Execute", System.Reflection.BindingFlags.InvokeMethod, null, upd, null);
                updType.InvokeMember("Close",   System.Reflection.BindingFlags.InvokeMethod, null, upd, null);
            }
        }
        dbType.InvokeMember("Commit", System.Reflection.BindingFlags.InvokeMethod, null, db, null);
        Log.LogMessage(MessageImportance.High, "HideChangeButton: ControlCondition rows added to " + MsiPath);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="HideChangeButton" AfterTargets="Build">
    <HideMsiChangeButton MsiPath="$(MSBuildProjectDirectory)\$(OutputPath)ja-JP\$(OutputName).msi" />
  </Target>
</Project>
