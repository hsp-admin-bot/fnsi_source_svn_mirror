<?xml version="1.0" encoding="utf-8"?>
<Settings>
  <!--体重計設定-->
  <ScaleBed>
    <!--体重計番号-->
    <WeightNo></WeightNo>
    <!--アップデート確認時刻-->
    <UpdateTime>02:00</UpdateTime>
    <!--スケールベッド接続状態確認用データ定期送信間隔-->
	<SendKeepAliveInterval>30</SendKeepAliveInterval>
  </ScaleBed>
  <!--共通設定-->
  <Common>
    <!--クライアント証明書検索キー値1-->
    <ClientCertificateSearchValue1></ClientCertificateSearchValue1>
    <!--クライアント証明書検索キー値2-->
    <ClientCertificateSearchValue2></ClientCertificateSearchValue2>
    <!--ユーザーID-->
    <UserId>ScalBedApp4</UserId>
    <!--パスワード-->
    <UserPW>5pXgR2s7yK9zJ4hT</UserPW>
    <!--施設ハッシュ-->
    <FacilityHash></FacilityHash>
    <!--ホストアドレス-->
    <BaseUri>https://fnwsi.nksfn.com</BaseUri>
    <!-- 最新ファイル取得先フォルダ -->
    <DownloadFolder>s3://ntss-s3-root-service/Application_Update</DownloadFolder>
    <!-- 最新ファイル取得先ファイル名 -->  
    <DownloadFileName>NKKScaleBedUpdate.zip</DownloadFileName>
  </Common>
  <!--WebSocket設定-->
  <WebSocket>
    <!--接続先-->
    <URI>wss://aline.nksfn.com/ntss-client-comm/ntssclientcomm</URI>
    <!--KeepAlive間隔(既定値:20秒)-->
    <KeepAlive>20</KeepAlive>
  </WebSocket>
  <!--ログ設定-->
  <Log>
    <!--ログの保存先-->
    <Folder></Folder>
    <!--ログ保持日数-->
    <KeepNumberOfDays></KeepNumberOfDays>
  </Log>
  <!--GUI接続用設定-->
  <Tool>
    <!--処理ログ表示ツール用待ち受けIPアドレス(空の場合はすべてのNICを対象)-->
    <IPAddress>127.0.0.1</IPAddress>
    <!--処理ログ表示ツール用待ち受けポートNo-->
    <PortNo>5013</PortNo>
  </Tool>
</Settings>