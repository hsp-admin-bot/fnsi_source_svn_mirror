<?xml version="1.0" encoding="utf-8"?>
<!--
  NKKAccessCard(FNWSi カードアプリ) インストーラー 日本語ローカライゼーション
  WiX v4 WXL ファイル

  Package Name="FNWSi カードアプリ" およびデスクトップショートカット名は
  変更せず、インストールウィザード画面の表示名のみ "FNWSi Access Card" に統一する。
-->
<WixLocalization xmlns="http://wixtoolset.org/schemas/v4/wxl"
                 Culture="ja-JP"
                 Codepage="932">

  <!-- .NET Framework 要件エラーメッセージ（将来 Product.wxs で !(loc.xxx) 参照用） -->
  <String Id="LaunchConditionNetFx45"
          Value=".NET Framework 4.5 以上が必要です。&#xA;&#xA;下記 URL からインストール後、再度セットアップを実行してください。&#xA;https://go.microsoft.com/fwlink/?LinkId=225704" />

  <!-- ウィザード画面名 -->
  <String Id="AdvancedWelcomeEulaDlg_Title" Value="FNWSi Access Card" />
  <String Id="BrowseDlg_Title" Value="FNWSi Access Card" />
  <String Id="CancelDlg_Title" Value="FNWSi Access Card" />
  <String Id="CustomizeDlg_Title" Value="FNWSi Access Card" />
