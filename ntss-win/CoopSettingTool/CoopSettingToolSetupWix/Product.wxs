<?xml version="1.0" encoding="UTF-8"?>
<!--
  CoopSettingTool WiX v4 インストーラー
  製品名   : CoopSettingTool
  バージョン: 2.0.6
  メーカー : Nikkiso
  インストール先: C:\FNWSiTools\CoopSettingTool

  画面フロー:
    ようこそ → インストール先選択 → 確認 → 進捗 → [設定ダイアログ(CA)] → 完了

  機能:
    - 日本語 UI
    - サイレントインストール(/quiet): 設定ダイアログをスキップ
    - バージョンダウングレード検知・ブロック
    - 実行中プロセスを自動終了（アップグレード/アンインストール時）
-->
<?include GeneratedProductCode.wxi?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
    Name="CoopSettingTool"
    Manufacturer="Nikkiso"
    Version="$(var.ProductVersion)"
    ProductCode="$(var.ProductCode)"
    UpgradeCode="{D7E09695-3C1D-42AD-9054-141F16BC845F}"
    Language="1041"
    Codepage="932"
    InstallerVersion="500"
    Compressed="yes"
    Scope="perMachine">

    <SummaryInformation Description="CoopSettingTool インストーラー" Keywords="インストーラー" />
    <MediaTemplate EmbedCab="yes" />

    <!-- ============================== アイコン ============================== -->
    <Icon Id="CoopSettingToolIcon" SourceFile="$(var.SrcSetup)CoopSettingTool.ico" />

    <Property Id="ARPPRODUCTICON" Value="CoopSettingToolIcon" />
    <Property Id="ARPCONTACT"     Value="Nikkiso" />
    <Property Id="ARPCOMMENTS"    Value="CoopSettingTool" />
    <SetProperty Id="ARPNOMODIFY" Value="1" Before="CostFinalize" Sequence="both" />

    <Property Id="REBOOT" Value="ReallySuppress" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="RUNNING_PROCESSES" Secure="yes" />
    <Property Id="ROOTDRIVE" Value="C:\" />

    <!-- ============================== .NET Framework 4.6.2 チェック ============================== -->
    <Property Id="NETFRAMEWORK45" Secure="yes">
      <RegistrySearch Id="NetFx45Search"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full"
                      Name="Release"
                      Type="raw" />
    </Property>
    <Launch Condition="NETFRAMEWORK45"
            Message=".NET Framework 4.6.2 以上が必要です。インストールしてから再度実行してください。" />

    <!-- ============================== バージョン管理 ============================== -->
    <Upgrade Id="{D7E09695-3C1D-42AD-9054-141F16BC845F}">
      <UpgradeVersion
        Minimum="0.0.0"
        Maximum="$(var.ProductVersion)"
        IncludeMinimum="yes"
        IncludeMaximum="no"
        Property="OLDERVERSIONBEINGUPGRADED"
        MigrateFeatures="yes" />
      <UpgradeVersion
        Minimum="$(var.ProductVersion)"
        IncludeMinimum="no"
        Property="NEWERVERSIONALREADYINSTALLED" />
    </Upgrade>

    <Launch Condition="NOT NEWERVERSIONALREADYINSTALLED"
            Message="より新しいバージョンがインストール済みです。アンインストールしてから再度インストールしてください。" />

    <!-- ============================== ディレクトリ構成 ============================== -->
    <!--
      デフォルト: C:\FNWSiTools\CoopSettingTool
      TARGETDIR(C:\) > FNWSITOOLS(FNWSiTools) > INSTALLFOLDER(CoopSettingTool)
                       > DIR_ASSETS(Assets) > DIR_ASSETS_HELP(Help)
                                            > DIR_ASSETS_IMGS(imgs)
    -->
    <StandardDirectory Id="TARGETDIR">
      <Directory Id="FNWSITOOLS" Name="FNWSiTools">
        <Directory Id="INSTALLFOLDER" Name="CoopSettingTool">
          <Directory Id="DIR_ASSETS" Name="Assets">
            <Directory Id="DIR_ASSETS_HELP" Name="Help" />
            <Directory Id="DIR_ASSETS_IMGS" Name="imgs" />
          </Directory>
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="WindowsFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- ============================== コンポーネント ============================== -->

    <!-- (1) メインアプリケーション -->
    <Component Id="C_MainExe"
               Guid="{D7E09695-3C1D-42AD-9054-141F16BC0001}"
               Directory="INSTALLFOLDER">
      <File Id="F_MainExe"
            Source="$(var.SrcBin)FNWSiCoopSettingTool.exe"
            KeyPath="yes" />
      <RemoveFile Id="RF_InstallState"
                  Name="CoopSettingTool.App.InstallState"
                  On="uninstall" />
    </Component>

    <!-- (2) FNWSiCoopSettingTool.exe.config -->
    <Component Id="C_ExeConfig"
               Guid="{D7E09695-3C1D-42AD-9054-141F16BC0002}"
               Directory="INSTALLFOLDER">
      <File Id="F_ExeConfig"
            Source="$(var.SrcBin)FNWSiCoopSettingTool.exe.config"
            KeyPath="yes" />
    </Component>

    <!-- (3) ApplicationConfig.json（サーバー接続設定、ユーザー設定を保持） -->
    <Component Id="C_ApplicationConfig"
               Guid="{D7E09695-3C1D-42AD-9054-141F16BC0003}"
               Directory="INSTALLFOLDER"
               Permanent="yes"
               NeverOverwrite="yes">
      <File Id="F_ApplicationConfig"
            Source="$(var.SrcBin)ApplicationConfig.json"
            KeyPath="yes" />
    </Component>

    <!-- (4) Log4Net.config（ログ設定） -->
    <Component Id="C_Log4NetConfig"
               Guid="{D7E09695-3C1D-42AD-9054-141F16BC0004}"
               Directory="INSTALLFOLDER">
      <File Id="F_Log4NetConfig"
            Source="$(var.SrcBin)Log4Net.config"
            KeyPath="yes" />
    </Component>

    <!-- (5) Assets\Help\manual.pdf -->
    <Component Id="C_ManualPdf"
               Guid="{D7E09695-3C1D-42AD-9054-141F16BC0005}"
               Directory="DIR_ASSETS_HELP">
      <File Id="F_ManualPdf"
            Source="$(var.SrcBin)Assets\Help\manual.pdf"
            KeyPath="yes" />
    </Component>

    <!-- (6) Assets\imgs\loading.gif -->
    <Component Id="C_LoadingGif"
               Guid="{D7E09695-3C1D-42AD-9054-141F16BC0006}"
               Directory="DIR_ASSETS_IMGS">
      <File Id="F_LoadingGif"
            Source="$(var.SrcBin)Assets\imgs\loading.gif"
            KeyPath="yes" />
    </Component>

    <!-- (7) デスクトップショートカット -->
    <Component Id="C_DesktopShortcut"
               Guid="{D7E09695-3C1D-42AD-9054-141F16BC0020}"
               Directory="INSTALLFOLDER">
      <Shortcut Id="SC_CoopSettingTool"
                Directory="DesktopFolder"
                Name="連携設定ツール"
                Target="[INSTALLFOLDER]FNWSiCoopSettingTool.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="CoopSettingToolIcon" />
      <RegistryValue Root="HKCU"
                     Key="Software\Nikkiso\CoopSettingTool"
                     Name="ShortcutsInstalled"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
      <RemoveRegistryKey Root="HKCU"
                         Key="Software\Nikkiso\CoopSettingTool"
                         Action="removeOnUninstall" />
    </Component>

    <!-- (8) 共有 DLL 群 -->
    <ComponentGroup Id="CG_SharedDlls" Directory="INSTALLFOLDER">
      <!-- ProjectReference DLLs -->
      <Component Guid="{D7E09695-3C1D-42AD-9054-141F16BC0011}"><File Source="$(var.SrcBin)CoopSettingTool.Service.dll" /></Component>
      <Component Guid="{D7E09695-3C1D-42AD-9054-141F16BC0012}"><File Source="$(var.SrcBin)CoopSettingTool.LogHelper.dll" /></Component>
      <!-- NuGet DLLs -->
      <Component Guid="{D7E09695-3C1D-42AD-9054-141F16BC0013}"><File Source="$(var.SrcBin)log4net.dll" /></Component>
      <Component Guid="{D7E09695-3C1D-42AD-9054-141F16BC0014}"><File Source="$(var.SrcBin)MaterialSkin.dll" /></Component>
      <Component Guid="{D7E09695-3C1D-42AD-9054-141F16BC0015}"><File Source="$(var.SrcBin)Newtonsoft.Json.dll" /></Component>
      <Component Guid="{D7E09695-3C1D-42AD-9054-141F16BC0016}"><File Source="$(var.SrcBin)Ninject.dll" /></Component>
      <Component Guid="{D7E09695-3C1D-42AD-9054-141F16BC0017}"><File Source="$(var.SrcBin)NLog.dll" /></Component>
      <Component Guid="{D7E09695-3C1D-42AD-9054-141F16BC0018}"><File Source="$(var.SrcBin)System.Linq.Dynamic.dll" /></Component>
      <Component Guid="{D7E09695-3C1D-42AD-9054-141F16BC0019}"><File Source="$(var.SrcBin)JsonSubTypes.dll" /></Component>
    </ComponentGroup>

    <!-- ============================== フィーチャー ============================== -->
    <Feature Id="ProductFeature"
             Title="CoopSettingTool"
             Level="1"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="C_MainExe" />
      <ComponentRef Id="C_ExeConfig" />
      <ComponentRef Id="C_ApplicationConfig" />
      <ComponentRef Id="C_Log4NetConfig" />
      <ComponentRef Id="C_ManualPdf" />
      <ComponentRef Id="C_LoadingGif" />
      <ComponentRef Id="C_DesktopShortcut" />
      <ComponentGroupRef Id="CG_SharedDlls" />
    </Feature>

    <!-- ============================== カスタムアクション ============================== -->

    <!-- 実行中プロセスを強制終了（ファイルロック解放） -->
    <CustomAction Id="KillRunningInstances"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /c taskkill /F /IM FNWSiCoopSettingTool.exe &gt; nul 2&gt;&amp;1"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- インストール先を deferred CA に渡すためのデータセット -->
    <CustomAction Id="SetInstallProperty"
                  Property="RunInstallUtil"
                  Value="&quot;[INSTALLFOLDER]FNWSiCoopSettingTool.exe&quot;" />

    <!-- サイレントインストール時: /silent=1 をアセンブリパスの前に配置 -->
    <CustomAction Id="SetInstallPropertySilent"
                  Property="RunInstallUtil"
                  Value="/silent=1 &quot;[INSTALLFOLDER]FNWSiCoopSettingTool.exe&quot;" />

    <!-- InstallUtil.exe で ProjectInstaller を実行（設定ダイアログ表示） -->
    <CustomAction Id="RunInstallUtil"
                  Directory="WindowsFolder"
                  ExeCommand="Microsoft.NET\Framework\v4.0.30319\InstallUtil.exe /LogToConsole=false /LogFile= [RunInstallUtil]"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <CustomAction Id="CA_DetectRunningProcesses"
                  Execute="immediate"
                  Return="ignore"
                  Script="vbscript"
                  ScriptSourceFile="Scripts\CA_DetectRunningProcesses.vbs" />
    <CustomAction Id="CA_KillGUIApps"
                  Execute="immediate"
                  Return="ignore"
                  Script="vbscript"
                  ScriptSourceFile="Scripts\CA_KillGUIApps.vbs" />

    <!-- ============================== シーケンス ============================== -->
    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallInitialize" />
      <Custom Action="KillRunningInstances" Before="RemoveFiles" Condition="1" />
      <Custom Action="SetInstallProperty" Before="RunInstallUtil"
              Condition="NOT REMOVE AND UILevel &gt;= 5" />
      <Custom Action="SetInstallPropertySilent" Before="RunInstallUtil"
              Condition="NOT REMOVE AND UILevel &lt; 5" />
      <Custom Action="RunInstallUtil" After="InstallFiles"
              Condition="NOT REMOVE" />
    </InstallExecuteSequence>

    <!-- ============================== UI ============================== -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <UI>
      <Dialog Id="RunningProcessesDlg" Width="370" Height="270" Title="CoopSettingTool インストーラー">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}実行中アプリケーションの検出" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Text="インストール前にアプリケーションを終了してください。" />
        <Control Id="RunningAppsLabel" Type="Text" X="20" Y="58" Width="330" Height="30" Text="以下のアプリケーションが実行中のため、インストールを継続できません。" />
        <Control Id="RunningAppsList" Type="Text" X="30" Y="92" Width="310" Height="90" Text="[RUNNING_PROCESSES]" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="155" Y="243" Width="56" Height="17" Text="&lt; 戻る">
          <Publish Event="NewDialog" Value="WelcomeDlg" Condition="NOT Installed" />
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg" Condition="Installed" />
        </Control>
        <Control Id="CloseAndContinue" Type="PushButton" X="215" Y="243" Width="84" Height="17" Default="yes" Text="終了して続行">
          <Publish Event="DoAction" Value="CA_KillGUIApps" Order="1" Condition="1" />
          <Publish Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2" Condition="Installed" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="307" Y="243" Width="56" Height="17" Cancel="yes" Text="キャンセル">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
      </Dialog>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="DoAction" Value="CA_DetectRunningProcesses" Order="1" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="RunningProcessesDlg" Order="2" Condition="NOT Installed AND RUNNING_PROCESSES" />
      <Publish Dialog="WelcomeDlg"    Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="3" Condition="NOT Installed AND NOT RUNNING_PROCESSES" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="DoAction" Value="CA_DetectRunningProcesses" Order="1" Condition="Installed" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="RunningProcessesDlg" Order="2" Condition="Installed AND RUNNING_PROCESSES" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" Order="3" Condition="Installed AND NOT RUNNING_PROCESSES" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg"    Order="2" Condition="1" />
    </UI>

  </Package>

</Wix>
