<?xml version="1.0" encoding="UTF-8"?>
<!--
  FNSiViewSyncService WiX v4 インストーラー
  製品名   : FNSiViewSyncService
  バージョン: 2.0.0
  メーカー : Nikkiso
  インストール先: C:\FNWSiTools\FNSiViewSyncService

  画面フロー:
    ようこそ → インストール先選択 → 確認 → 進捗 → [設定ダイアログ(CA)] → 完了

  機能:
    - 日本語 UI
    - サイレントインストール(/quiet): 設定ダイアログをスキップ
    - バージョンダウングレード検知・ブロック
    - Windows サービス登録/解除（InstallUtil 経由）
    - sql ディレクトリ内ファイルの自動ハーベスト
-->
<?include GeneratedProductCode.wxi?>

<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package
    Name="FNSiViewSyncService"
    Manufacturer="Nikkiso"
    Version="$(var.ProductVersion)"
    ProductCode="$(var.ProductCode)"
    UpgradeCode="{7D876E9D-C73A-4A18-A1FC-65548469EB55}"
    Language="1041"
    Codepage="932"
    InstallerVersion="500"
    Compressed="yes"
    Scope="perMachine">

    <SummaryInformation Description="FNSiViewSyncService インストーラー" Keywords="インストーラー" />
    <MediaTemplate EmbedCab="yes" />

    <!-- ============================== アイコン ============================== -->
    <Icon Id="FNSiViewSyncServiceIcon" SourceFile="$(var.SrcSetup)nkk.ico" />

    <Property Id="ARPPRODUCTICON" Value="FNSiViewSyncServiceIcon" />
    <Property Id="ARPCONTACT"     Value="Nikkiso" />
    <Property Id="ARPCOMMENTS"    Value="FNSiViewSyncService" />
    <SetProperty Id="ARPNOMODIFY" Value="1" Before="CostFinalize" Sequence="both" />

    <Property Id="REBOOT" Value="ReallySuppress" />
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />
    <Property Id="RUNNING_PROCESSES" Secure="yes" />
    <Property Id="ROOTDRIVE" Value="C:\" />

    <!-- ============================== .NET Framework 4.5 チェック ============================== -->
    <Property Id="NETFRAMEWORK45" Secure="yes">
      <RegistrySearch Id="NetFx45Search"
                      Root="HKLM"
                      Key="SOFTWARE\Microsoft\NET Framework Setup\NDP\v4\Full"
                      Name="Release"
                      Type="raw" />
    </Property>
    <Launch Condition="NETFRAMEWORK45 &gt;= &quot;#378389&quot;"
            Message=".NET Framework 4.5 以降が必要です。インストールしてから再度実行してください。" />

    <!-- ============================== バージョン管理 ============================== -->
    <Upgrade Id="{7D876E9D-C73A-4A18-A1FC-65548469EB55}">
      <UpgradeVersion
        Minimum="0.0.0"
        Maximum="$(var.ProductVersion)"
        IncludeMinimum="yes"
        IncludeMaximum="no"
        Property="OLDERVERSIONBEINGUPGRADED"
        MigrateFeatures="yes" />
      <UpgradeVersion
        Minimum="$(var.ProductVersion)"
        IncludeMinimum="no"
        Property="NEWERVERSIONALREADYINSTALLED" />
    </Upgrade>

    <Launch Condition="NOT NEWERVERSIONALREADYINSTALLED"
            Message="より新しいバージョンがインストール済みです。アンインストールしてから再度インストールしてください。" />

    <!-- ============================== ディレクトリ構成 ============================== -->
    <!--
      デフォルト: C:\FNWSiTools\FNSiViewSyncService
      TARGETDIR(C:\) > FNWSITOOLS(FNWSiTools) > INSTALLFOLDER(FNSiViewSyncService) > DIR_SQL(sql)
    -->
    <StandardDirectory Id="TARGETDIR">
      <Directory Id="FNWSITOOLS" Name="FNWSiTools">
        <Directory Id="INSTALLFOLDER" Name="FNSiViewSyncService">
          <Directory Id="DIR_SQL" Name="sql" />
        </Directory>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="WindowsFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <!-- ============================== コンポーネント ============================== -->

    <!-- (1) メインサービス EXE -->
    <Component Id="C_MainExe"
               Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B001}"
               Directory="INSTALLFOLDER">
      <File Id="F_MainExe"
            Source="$(var.SrcBin)FNWSiCoopVIEW.exe"
            KeyPath="yes" />
    </Component>

    <!-- (2) FNWSiCoopVIEW.exe.config -->
    <Component Id="C_ExeConfig"
               Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B002}"
               Directory="INSTALLFOLDER">
      <File Id="F_ExeConfig"
            Source="$(var.SrcBin)FNWSiCoopVIEW.exe.config"
            KeyPath="yes" />
    </Component>

    <!-- (3) FNWSiCoopVIEWSyncTool.exe -->
    <Component Id="C_ToolExe"
               Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B003}"
               Directory="INSTALLFOLDER">
      <File Id="F_ToolExe"
            Source="$(var.SrcTool)FNWSiCoopVIEWSyncTool.exe"
            KeyPath="yes" />
    </Component>

    <!-- (4) FNWSiCoopVIEWSyncTool.exe.config -->
    <Component Id="C_ToolConfig"
               Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B004}"
               Directory="INSTALLFOLDER">
      <File Id="F_ToolConfig"
            Source="$(var.SrcTool)FNWSiCoopVIEWSyncTool.exe.config"
            KeyPath="yes" />
    </Component>

    <!-- (5) FNWSiCoopVIEWUpdate.exe -->
    <Component Id="C_UpdateExe"
               Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B005}"
               Directory="INSTALLFOLDER">
      <File Id="F_UpdateExe"
            Source="$(var.SrcUpdate)FNWSiCoopVIEWUpdate.exe"
            KeyPath="yes" />
    </Component>

    <!-- (6) FNWSiCoopVIEWUpdate.exe.config -->
    <Component Id="C_UpdateExeConfig"
               Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B006}"
               Directory="INSTALLFOLDER">
      <File Id="F_UpdateExeConfig"
            Source="$(var.SrcUpdate)FNWSiCoopVIEWUpdate.exe.config"
            KeyPath="yes" />
    </Component>

    <!-- (7) FNSiViewUpdateApp.config（ユーザー設定・NeverOverwrite） -->
    <Component Id="C_UpdateConfig"
               Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B007}"
               Directory="INSTALLFOLDER"
               Permanent="yes"
               NeverOverwrite="yes">
      <File Id="F_UpdateConfig"
            Source="$(var.SrcUpdate)FNSiViewUpdateApp.config"
            KeyPath="yes" />
    </Component>

    <!-- (8) FNSiViewSync.config（サービス接続設定・NeverOverwrite） -->
    <Component Id="C_ViewSyncConfig"
               Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B008}"
               Directory="INSTALLFOLDER"
               Permanent="yes"
               NeverOverwrite="yes">
      <File Id="F_ViewSyncConfig"
            Source="$(var.SrcBin)FNSiViewSync.config"
            KeyPath="yes" />
    </Component>

    <!-- (9) FNSiViewSync.xml（同期定義・NeverOverwrite） -->
    <Component Id="C_ViewSyncXml"
               Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B009}"
               Directory="INSTALLFOLDER"
               Permanent="yes"
               NeverOverwrite="yes">
      <File Id="F_ViewSyncXml"
            Source="$(var.SrcBin)FNSiViewSync.xml"
            KeyPath="yes" />
    </Component>

    <!-- (10) FNSiViewSync(クラウド).xml（クラウド用テンプレート・NeverOverwrite） -->
    <Component Id="C_CloudXml"
               Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B00A}"
               Directory="INSTALLFOLDER"
               Permanent="yes"
               NeverOverwrite="yes">
      <File Id="F_CloudXml"
            Source="$(var.SrcLogic)FNSiViewSync(クラウド).xml"
            KeyPath="yes" />
    </Component>

    <!-- (11) FNSiViewSync(オンプレ).xml（オンプレ用テンプレート・NeverOverwrite） -->
    <Component Id="C_OnPremXml"
               Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B00B}"
               Directory="INSTALLFOLDER"
               Permanent="yes"
               NeverOverwrite="yes">
      <File Id="F_OnPremXml"
            Source="$(var.SrcLogic)FNSiViewSync(オンプレ).xml"
            KeyPath="yes" />
    </Component>

    <!-- (12) デスクトップショートカット -->
    <Component Id="C_DesktopShortcut"
               Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B030}"
               Directory="INSTALLFOLDER">
      <Shortcut Id="SC_FNWSiCoopVIEWSyncTool"
                Directory="DesktopFolder"
                Name="VIEW連携同期"
                Target="[INSTALLFOLDER]FNWSiCoopVIEWSyncTool.exe"
                WorkingDirectory="INSTALLFOLDER"
                Icon="FNSiViewSyncServiceIcon" />
      <RegistryValue Root="HKCU"
                     Key="Software\Nikkiso\FNSiViewSyncService"
                     Name="ShortcutsInstalled"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
      <RemoveRegistryKey Root="HKCU"
                         Key="Software\Nikkiso\FNSiViewSyncService"
                         Action="removeOnUninstall" />
    </Component>

    <!-- (13) 共通 DLL 群 -->
    <ComponentGroup Id="CG_SharedDlls" Directory="INSTALLFOLDER">
      <Component Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B021}"><File Source="$(var.SrcBin)FNSiViewSyncLogic.dll" /></Component>
      <Component Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B022}"><File Source="$(var.SrcBin)NKKCommon.dll" /></Component>
      <Component Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B027}"><File Source="$(var.SrcBin)Ionic.Zip.dll" /></Component>
      <Component Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B023}"><File Source="$(var.SrcBin)Newtonsoft.Json.dll" /></Component>
      <Component Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B024}"><File Source="$(var.SrcLogicBin)SuperSocket.ClientEngine.dll" /></Component>
      <Component Guid="{B2C94F10-7E91-4A2D-9B4E-C5D6E3A1B026}"><File Source="$(var.SrcLogicBin)WebSocket4Net.dll" /></Component>
    </ComponentGroup>

    <!-- ============================== フィーチャー ============================== -->
    <Feature Id="ProductFeature"
             Title="FNSiViewSyncService"
             Level="1"
             ConfigurableDirectory="INSTALLFOLDER">
      <ComponentRef Id="C_MainExe" />
      <ComponentRef Id="C_ExeConfig" />
      <ComponentRef Id="C_ToolExe" />
      <ComponentRef Id="C_ToolConfig" />
      <ComponentRef Id="C_UpdateExe" />
      <ComponentRef Id="C_UpdateExeConfig" />
      <ComponentRef Id="C_UpdateConfig" />
      <ComponentRef Id="C_ViewSyncConfig" />
      <ComponentRef Id="C_ViewSyncXml" />
      <ComponentRef Id="C_CloudXml" />
      <ComponentRef Id="C_OnPremXml" />
      <ComponentGroupRef Id="CG_SharedDlls" />
      <ComponentRef Id="C_DesktopShortcut" />
      <ComponentGroupRef Id="CG_SqlFiles" />
    </Feature>

    <!-- ============================== カスタムアクション ============================== -->

    <!-- ツールプロセスの終了（アンインストール・アップグレード共通） -->
    <CustomAction Id="KillToolInstances"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /c taskkill /f /im FNWSiCoopVIEWSyncTool.exe > nul 2>&amp;1 &amp; taskkill /f /im FNSiViewUpdateApp.exe > nul 2>&amp;1"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- アップグレード時：旧バージョンのサービスを停止・削除 -->
    <CustomAction Id="StopDeleteServiceUpgrade"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /c sc stop FNSiViewSyncService &gt; nul 2&gt;&amp;1 &amp; timeout /t 5 /nobreak &gt; nul &amp; taskkill /f /im FNWSiCoopVIEW.exe &gt; nul 2&gt;&amp;1 &amp; sc delete FNSiViewSyncService &gt; nul 2&gt;&amp;1"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- アンインストール時：サービスを停止 -->
    <CustomAction Id="StopServiceUninstall"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /c sc stop FNSiViewSyncService &gt; nul 2&gt;&amp;1 &amp; timeout /t 5 /nobreak &gt; nul &amp; taskkill /f /im FNWSiCoopVIEW.exe &gt; nul 2&gt;&amp;1"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- アンインストール用プロパティ設定 -->
    <CustomAction Id="SetUninstallProperty"
                  Property="RunUninstallUtil"
                  Value="&quot;[INSTALLFOLDER]FNWSiCoopVIEW.exe&quot;" />

    <!-- InstallUtil /u でサービス解除 -->
    <CustomAction Id="RunUninstallUtil"
                  Directory="WindowsFolder"
                  ExeCommand="Microsoft.NET\Framework\v4.0.30319\InstallUtil.exe /u /LogToConsole=false /LogFile= [RunUninstallUtil]"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <!-- インストール用プロパティ設定 -->
    <CustomAction Id="SetInstallProperty"
                  Property="RunInstallUtil"
                  Value="&quot;[INSTALLFOLDER]FNWSiCoopVIEW.exe&quot;" />

    <!-- サイレントインストール時: /silent=1 を先頭に付加 -->
    <CustomAction Id="SetInstallPropertySilent"
                  Property="RunInstallUtil"
                  Value="/silent=1 &quot;[INSTALLFOLDER]FNWSiCoopVIEW.exe&quot;" />

    <!-- InstallUtil でサービス登録・設定ダイアログ表示 -->
    <CustomAction Id="RunInstallUtil"
                  Directory="WindowsFolder"
                  ExeCommand="Microsoft.NET\Framework\v4.0.30319\InstallUtil.exe /LogToConsole=false /LogFile= [RunInstallUtil]"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check" />
    <CustomAction Id="StartServiceAfterInstallSilent"
                  Directory="SystemFolder"
                  ExeCommand="cmd.exe /c sc start FNSiViewSyncService &gt; nul 2&gt;&amp;1"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <CustomAction Id="CA_DetectRunningProcesses"
                  Execute="immediate"
                  Return="ignore"
                  Script="vbscript"
                  ScriptSourceFile="Scripts\CA_DetectRunningProcesses.vbs" />
    <CustomAction Id="CA_KillGUIApps"
                  Execute="immediate"
                  Return="ignore"
                  Script="vbscript"
                  ScriptSourceFile="Scripts\CA_KillGUIApps.vbs" />

    <!-- ============================== シーケンス ============================== -->
    <InstallExecuteSequence>
      <!-- InstallValidate のファイル使用中チェックをスキップ（待機を回避）
           ファイルロック解除は DEFERRED StopServiceUninstall (SYSTEM権限) が担当する -->
      <InstallValidate Condition="0" />
      <RemoveExistingProducts After="InstallInitialize" />
      <!-- アップグレード・アンインストール・修復時：ツールプロセスを終了 -->
      <Custom Action="KillToolInstances" Before="StopDeleteServiceUpgrade" Condition="REMOVE OR Installed" />
      <!-- アップグレード時：旧サービスを停止・削除 -->
      <Custom Action="StopDeleteServiceUpgrade" Before="RemoveFiles" Condition="UPGRADINGPRODUCTCODE" />
      <!-- アンインストール時 + 修復時：サービス停止(SYSTEM権限) → InstallUtil /u でサービス登録解除 -->
      <Custom Action="StopServiceUninstall" Before="SetUninstallProperty"  Condition="NOT UPGRADINGPRODUCTCODE AND (REMOVE OR Installed)" />
      <Custom Action="SetUninstallProperty" Before="RunUninstallUtil"      Condition="NOT UPGRADINGPRODUCTCODE AND (REMOVE OR Installed)" />
      <Custom Action="RunUninstallUtil"     Before="RemoveFiles"           Condition="NOT UPGRADINGPRODUCTCODE AND (REMOVE OR Installed)" />
      <!-- インストール時 + 修復時：ファイルコピー後に InstallUtil でサービス再登録・ダイアログ表示 -->
      <Custom Action="SetInstallProperty"        Before="RunInstallUtil"   Condition="NOT REMOVE AND UILevel &gt;= 5" />
      <Custom Action="SetInstallPropertySilent"  Before="RunInstallUtil"   Condition="NOT REMOVE AND UILevel &lt; 5" />
      <Custom Action="RunInstallUtil"            After="InstallFiles"      Condition="NOT REMOVE" />
      <Custom Action="StartServiceAfterInstallSilent" After="RunInstallUtil" Condition="NOT REMOVE AND UILevel &lt; 5" />
    </InstallExecuteSequence>

    <!-- ============================== UI ============================== -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <UI>
      <Dialog Id="RunningProcessesDlg" Width="370" Height="270" Title="FNSiViewSyncService インストーラー">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="WixUI_Bmp_Banner" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="340" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}実行中アプリケーションの検出" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="340" Height="15" Text="インストール前にアプリケーションを終了してください。" />
        <Control Id="RunningAppsLabel" Type="Text" X="20" Y="58" Width="330" Height="30" Text="以下のアプリケーション/サービスが実行中のため、インストールを継続できません。" />
        <Control Id="RunningAppsList" Type="Text" X="30" Y="92" Width="310" Height="90" Text="[RUNNING_PROCESSES]" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="155" Y="243" Width="56" Height="17" Text="&lt; 戻る">
          <Publish Event="NewDialog" Value="WelcomeDlg" Condition="NOT Installed" />
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg" Condition="Installed" />
        </Control>
        <Control Id="CloseAndContinue" Type="PushButton" X="215" Y="243" Width="84" Height="17" Default="yes" Text="終了して続行">
          <Publish Event="DoAction" Value="CA_KillGUIApps" Order="1" Condition="1" />
          <Publish Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Order="2" Condition="Installed" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="307" Y="243" Width="56" Height="17" Cancel="yes" Text="キャンセル">
          <Publish Event="SpawnDialog" Value="CancelDlg" Condition="1" />
        </Control>
      </Dialog>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="DoAction" Value="CA_DetectRunningProcesses" Order="1" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="RunningProcessesDlg" Order="2" Condition="NOT Installed AND RUNNING_PROCESSES" />
      <Publish Dialog="WelcomeDlg"    Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="3" Condition="NOT Installed AND NOT RUNNING_PROCESSES" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="DoAction" Value="CA_DetectRunningProcesses" Order="1" Condition="Installed" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="RunningProcessesDlg" Order="2" Condition="Installed AND RUNNING_PROCESSES" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" Order="3" Condition="Installed AND NOT RUNNING_PROCESSES" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg"    Order="2" Condition="1" />
    </UI>

  </Package>

</Wix>
