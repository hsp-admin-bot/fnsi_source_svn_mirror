<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="WixToolset.Sdk/4.0.6">
  <PropertyGroup>
    <OutputType>Package</OutputType>
    <OutputName>FNSiViewSyncServiceSetup</OutputName>
    <Platforms>x86</Platforms>
    <Platform Condition="'$(Platform)' == ''">x86</Platform>
    <Cultures>ja-JP</Cultures>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <!--
      ★ バージョンアップ時はここだけ変更する ★
      ProductCode は UpgradeCodeGuid + ProductVersion から自動生成される（UUID v5）
      UpgradeCodeGuid は絶対に変えない
    -->
    <ProductVersion>2.0.16</ProductVersion>
    <UpgradeCodeGuid>B2C94F10-7E91-4A2D-9B4E-C5D6E3A1F7D8</UpgradeCodeGuid>
    <!-- MSBuild プロパティとして定義（HarvestDirectory でも参照可能） -->
    <SrcBin>$(MSBuildProjectDirectory)\..\FNSiViewSyncService\bin\$(Configuration)\</SrcBin>
    <SrcLogicBin>$(MSBuildProjectDirectory)\..\FNSiViewSyncLogic\bin\$(Configuration)\</SrcLogicBin>
    <SrcTool>$(MSBuildProjectDirectory)\..\FNSiViewSyncTool\bin\$(Configuration)\</SrcTool>
    <SrcUpdate>$(MSBuildProjectDirectory)\..\FNSiViewUpdateApp\bin\$(Configuration)\</SrcUpdate>
    <SrcLogic>$(MSBuildProjectDirectory)\..\FNSiViewSyncLogic\</SrcLogic>
    <SrcSetup>$(MSBuildProjectDirectory)\..\FNSiViewSyncServiceSetup\</SrcSetup>
    <DefineConstants>
      SrcBin=$(SrcBin);
      SrcLogicBin=$(SrcLogicBin);
      SrcTool=$(SrcTool);
      SrcUpdate=$(SrcUpdate);
      SrcLogic=$(SrcLogic);
      SrcSetup=$(SrcSetup);
      ProductVersion=$(ProductVersion)
    </DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext"   Version="4.0.6" />
    <PackageReference Include="WixToolset.Util.wixext" Version="4.0.6" />
  </ItemGroup>

  <UsingTask TaskName="GenerateUuidV5ProductCode"
             TaskFactory="CodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <UpgradeCode    ParameterType="System.String" Required="true" />
      <ProductVersion ParameterType="System.String" Required="true" />
      <OutputFile     ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var nsGuid  = System.Guid.Parse(UpgradeCode);
        var nsBytes = nsGuid.ToByteArray();
        System.Array.Reverse(nsBytes, 0, 4);
        System.Array.Reverse(nsBytes, 4, 2);
        System.Array.Reverse(nsBytes, 6, 2);

        var verBytes = System.Text.Encoding.UTF8.GetBytes(ProductVersion);
        var input    = new byte[nsBytes.Length + verBytes.Length];
        System.Array.Copy(nsBytes,  0, input, 0,              nsBytes.Length);
        System.Array.Copy(verBytes, 0, input, nsBytes.Length,  verBytes.Length);

        var sha1 = System.Security.Cryptography.SHA1.Create();
        var hash = sha1.ComputeHash(input);

        var h = new byte[16];
        System.Array.Copy(hash, h, 16);
        h[6] = (byte)((h[6] & 0x0F) | 0x50);
        h[8] = (byte)((h[8] & 0x3F) | 0x80);

        System.Array.Reverse(h, 0, 4);
        System.Array.Reverse(h, 4, 2);
        System.Array.Reverse(h, 6, 2);

        var productCode = new System.Guid(h).ToString("B").ToUpper();
        Log.LogMessage(MessageImportance.High, "ProductCode (v" + ProductVersion + "): " + productCode);

        var lines = new string[] {
            "<?xml version=\"1.0\" encoding=\"utf-8\"?>",
            "<Include>",
            "  <?define ProductCode = \"" + productCode + "\" ?>",
            "</Include>"
        };
        System.IO.File.WriteAllLines(OutputFile, lines, System.Text.Encoding.UTF8);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateProductCode" BeforeTargets="CoreCompile;Build">
    <GenerateUuidV5ProductCode
      UpgradeCode="$(UpgradeCodeGuid)"
      ProductVersion="$(ProductVersion)"
      OutputFile="$(MSBuildProjectDirectory)\GeneratedProductCode.wxi" />
  </Target>

  <!-- sql ディレクトリ内のファイルを列挙し、明示 GUID 付きの ComponentGroup を生成 -->
  <UsingTask TaskName="GenerateSqlFilesWxs"
             TaskFactory="CodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <SqlDir    ParameterType="System.String" Required="true" />
      <OutputFile ParameterType="System.String" Required="true" />
      <NamespaceGuid ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        // UUID v5 (SHA-1 based) deterministic GUID generation
        System.Func<System.Guid, string, System.Guid> uuidV5 = (nsGuid2, name2) => {
            var nb = nsGuid2.ToByteArray();
            System.Array.Reverse(nb, 0, 4);
            System.Array.Reverse(nb, 4, 2);
            System.Array.Reverse(nb, 6, 2);
            var nameBytes2 = System.Text.Encoding.UTF8.GetBytes(name2);
            var input2 = new byte[nb.Length + nameBytes2.Length];
            System.Array.Copy(nb,         0, input2, 0,          nb.Length);
            System.Array.Copy(nameBytes2, 0, input2, nb.Length,  nameBytes2.Length);
            var hash2 = System.Security.Cryptography.SHA1.Create().ComputeHash(input2);
            var h2 = new byte[16];
            System.Array.Copy(hash2, h2, 16);
            h2[6] = (byte)((h2[6] & 0x0F) | 0x50);
            h2[8] = (byte)((h2[8] & 0x3F) | 0x80);
            System.Array.Reverse(h2, 0, 4);
            System.Array.Reverse(h2, 4, 2);
            System.Array.Reverse(h2, 6, 2);
            return new System.Guid(h2);
        };

        var sqlNs = System.Guid.Parse(NamespaceGuid);
        var files = System.IO.Directory.GetFiles(SqlDir, "*.sql");
        System.Array.Sort(files);

        var sb = new System.Text.StringBuilder();
        sb.AppendLine("<?xml version=\"1.0\" encoding=\"UTF-8\"?>");
        sb.AppendLine("<!-- 自動生成 - 手動編集不可 (GenerateSqlFilesWxs MSBuild ターゲット) -->");
        sb.AppendLine("<Wix xmlns=\"http://wixtoolset.org/schemas/v4/wxs\">");
        sb.AppendLine("  <Fragment>");
        sb.AppendLine("    <ComponentGroup Id=\"CG_SqlFiles\" Directory=\"DIR_SQL\">");
        foreach (var f in files) {
            var fname  = System.IO.Path.GetFileName(f);
            var guid   = uuidV5(sqlNs, "FNSiViewSyncService.sql." + fname).ToString("B").ToUpper();
            var safeId = "sql_" + System.Text.RegularExpressions.Regex.Replace(fname, @"[^A-Za-z0-9_]", "_");
            sb.AppendLine("      <Component Id=\"C_" + safeId + "\" Guid=\"" + guid + "\">");
            sb.AppendLine("        <File Id=\"F_" + safeId + "\" Source=\"" + f + "\" KeyPath=\"yes\" />");
            sb.AppendLine("      </Component>");
        }
        sb.AppendLine("    </ComponentGroup>");
        sb.AppendLine("  </Fragment>");
        sb.AppendLine("</Wix>");

        System.IO.File.WriteAllText(OutputFile, sb.ToString(), System.Text.Encoding.UTF8);
        Log.LogMessage(MessageImportance.High, "GenerateSqlFilesWxs: " + files.Length + " files -> " + OutputFile);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateSqlFilesWxs" BeforeTargets="CoreCompile;Build">
    <GenerateSqlFilesWxs
      SqlDir="$(SrcBin)sql"
      OutputFile="$(MSBuildProjectDirectory)\GeneratedSqlFiles.wxs"
      NamespaceGuid="$(UpgradeCodeGuid)" />
  </Target>

  <UsingTask TaskName="HideMsiChangeButton"
             TaskFactory="CodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <MsiPath ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs"><![CDATA[
        var type      = System.Type.GetTypeFromProgID("WindowsInstaller.Installer");
        var installer = System.Activator.CreateInstance(type);
        var db = type.InvokeMember("OpenDatabase", System.Reflection.BindingFlags.InvokeMethod, null, installer,
                     new object[] { MsiPath, 1 });
        var dbType = db.GetType();
        var sqls = new string[][] {
            new string[] {
                "INSERT INTO ControlCondition (Dialog_, Control_, Action, Condition) VALUES ('MaintenanceTypeDlg', 'ChangeButton',       'Hide', '1')",
                "UPDATE ControlCondition SET Condition = '1' WHERE Dialog_ = 'MaintenanceTypeDlg' AND Control_ = 'ChangeButton'       AND Action = 'Hide'"
            },
            new string[] {
                "INSERT INTO ControlCondition (Dialog_, Control_, Action, Condition) VALUES ('MaintenanceTypeDlg', 'ChangeDisabledText', 'Hide', '1')",
                "UPDATE ControlCondition SET Condition = '1' WHERE Dialog_ = 'MaintenanceTypeDlg' AND Control_ = 'ChangeDisabledText' AND Action = 'Hide'"
            }
        };
        foreach (var sqlPair in sqls) {
            var view = dbType.InvokeMember("OpenView", System.Reflection.BindingFlags.InvokeMethod, null, db,
                           new object[] { sqlPair[0] });
            var viewType = view.GetType();
            bool ok = false;
            try {
                viewType.InvokeMember("Execute", System.Reflection.BindingFlags.InvokeMethod, null, view, null);
                ok = true;
            } catch (System.Runtime.InteropServices.COMException) { }
            viewType.InvokeMember("Close", System.Reflection.BindingFlags.InvokeMethod, null, view, null);
            if (!ok) {
                var upd = dbType.InvokeMember("OpenView", System.Reflection.BindingFlags.InvokeMethod, null, db,
                              new object[] { sqlPair[1] });
                var updType = upd.GetType();
                updType.InvokeMember("Execute", System.Reflection.BindingFlags.InvokeMethod, null, upd, null);
                updType.InvokeMember("Close",   System.Reflection.BindingFlags.InvokeMethod, null, upd, null);
            }
        }
        dbType.InvokeMember("Commit", System.Reflection.BindingFlags.InvokeMethod, null, db, null);
        Log.LogMessage(MessageImportance.High, "HideChangeButton: ControlCondition rows added to " + MsiPath);
      ]]></Code>
    </Task>
  </UsingTask>

  <Target Name="HideChangeButton" AfterTargets="Build">
    <HideMsiChangeButton MsiPath="$(MSBuildProjectDirectory)\$(OutputPath)$(OutputName).msi" />
  </Target>
</Project>
