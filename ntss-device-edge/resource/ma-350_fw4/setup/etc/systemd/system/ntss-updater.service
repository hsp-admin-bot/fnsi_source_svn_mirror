[Unit]
Description=ntss updater service

[Service]
# set working directory
WorkingDirectory=/home/ntss/ntss
# systemctl start [serviceName] : action
ExecStart = /home/ntss/ntss/ntss_updater.exe
# if service is stop, [always]: always restart
Restart = always
# service start success: command ok
Type = simple
# log
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
